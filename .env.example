# GlowIQ Root Environment Configuration Template
# For service-specific configurations, see:
# - frontend/.env.example
# - backend/.env.example

# ── Backend Configuration (Render) ──
PORT=8000
HOST=0.0.0.0
APP_ENV=production
GROQ_API_KEY=your_groq_api_key_here
ALLOWED_ORIGINS=https://your-glowiq-frontend.vercel.app,http://localhost:5173
DEFAULT_ADMIN_EMAIL=admin@glowiq.com
DEFAULT_ADMIN_PASSWORD=YourSecurePassword123!

# ── Frontend Configuration (Vercel) ──
VITE_API_URL=https://your-glowiq-backend.onrender.com
VITE_APP_ENV=production
