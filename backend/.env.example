# GlowIQ Backend Environment Configuration Template
# =================================================

# ── AI Skin Analysis (Groq Cloud) ──
# Free API key from https://console.groq.com (no credit card needed).
# If left empty, the server automatically uses demo fallback mode.
GROQ_API_KEY=

# ── Server & Runtime ──
# Render sets PORT automatically at runtime; defaults to 8000 locally
PORT=8000
HOST=0.0.0.0
# Mode: 'production' (clean) or 'qa' (buggy RCA evaluation)
APP_ENV=qa
PYTHON_VERSION=3.11.9

# ── CORS Allowed Origins ──
# Comma-separated list of allowed frontend origins.
# (Note: All *.vercel.app domains are automatically allowed by built-in regex)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database Configuration (Optional Overrides) ──
# Defaults to backend/database/users.db and backend/database/skincare_clicks.db
# Set custom path (e.g. Render Persistent Disk: /var/data/users.db):
# DATABASE_PATH=/var/data/users.db
# CLICK_DB_PATH=/var/data/skincare_clicks.db

# ── Default Admin Account Setup ──
DEFAULT_ADMIN_EMAIL=admin@glowiq.com
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!
DEFAULT_ADMIN_NAME=GlowIQ Administrator
