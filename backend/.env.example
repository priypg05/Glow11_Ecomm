# GlowIQ Backend Environment Configuration

# ── Required for AI Skin Analysis ──
# Free API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Server & Runtime ──
PORT=8000
HOST=0.0.0.0
APP_ENV=production

# ── CORS Configuration ──
# Comma-separated list of allowed frontend origins
# Regex automatically allows *.vercel.app and *.devtunnels.ms
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── Default Admin Account Setup ──
DEFAULT_ADMIN_EMAIL=admin@glowiq.com
DEFAULT_ADMIN_PASSWORD=ChangeThisSecurePassword!123
DEFAULT_ADMIN_NAME=GlowIQ Admin

# ── Database & Dataset Paths (Optional Overrides) ──
# Defaults to backend/database/ or backend/
# DATABASE_PATH=database/users.db
# CLICK_DB_PATH=database/skincare_clicks.db
# CSV_PATH=datasets/Skin_Care.csv
