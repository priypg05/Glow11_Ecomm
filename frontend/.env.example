# GlowIQ Frontend Environment Configuration
# ==========================================

# ── Backend API Base URL ──
# Local development:
VITE_API_URL=http://localhost:8000
# Production on Vercel (uncomment & replace with your actual Render URL):
# VITE_API_URL=https://<your-service-name>.onrender.com

# ── Application Environment ──
# Environment Mode: 'production' or 'qa' (QA testing mode with planted bugs)
VITE_APP_ENV=qa

# ── AI Skin Analysis & Chatbot (Optional) ──
# Groq Cloud API Key for direct client-side requests if used:
# Get free key at: https://console.groq.com
VITE_GROQ_API_KEY=
